{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillHub inventory V1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "kind": {
            "type": "string",
            "enum": [
              "shared",
              "codex",
              "claude-code",
              "cursor",
              "custom"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "project",
              "custom"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "scanned",
              "partial",
              "missing",
              "unreadable",
              "skipped_link"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "scope",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "installations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "skillMdSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\s)[\\s\\S]*\\S(?![\\s\\S])"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!\\s)[\\s\\S]*\\S(?![\\s\\S])"
          },
          "compatibility": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\s)[\\s\\S]*\\S(?![\\s\\S])"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rootId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                },
                "relativePath": {
                  "type": "string",
                  "maxLength": 1024,
                  "pattern": "^(?=(?:[^/]+/)*[Ss][Kk][Ii][Ll][Ll]\\.[Mm][Dd](?![\\s\\S]))(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+)*(?![\\s\\S])"
                }
              },
              "required": [
                "rootId",
                "relativePath"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 32
          }
        },
        "required": [
          "id",
          "skillMdSha256",
          "name",
          "description",
          "locations"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rootId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "code": {
            "type": "string",
            "enum": [
              "root_unavailable",
              "directory_unreadable",
              "link_skipped",
              "invalid_file",
              "ambiguous_filename",
              "invalid_front_matter",
              "limit_reached"
            ]
          },
          "relativePath": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+)*(?![\\s\\S])"
          }
        },
        "required": [
          "rootId",
          "code"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "omittedDiagnostics": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "roots",
    "installations",
    "diagnostics",
    "omittedDiagnostics"
  ],
  "additionalProperties": false
}
